/ {
    chosen {
        zephyr,console = &board_cdc_acm_uart;        // the board's own USB-C port (a serial port on the computer): no wires needed
        zephyr,shell-uart = &board_cdc_acm_uart;   // for the D6 TX / D7 RX adapter use &uart0 in both lines
    };
};
&uart0 { status = "okay"; current-speed = <115200>; };
&nfct { status = "okay"; };                              // NFC tag on the two NFC pads (P0.09 / P0.10)
