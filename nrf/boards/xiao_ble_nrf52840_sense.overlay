/ {
    chosen {
        zephyr,console = &uart0;        // D6 TX / D7 RX, to the USB-TTL adapter
        zephyr,shell-uart = &uart0;
    };
};
&uart0 { status = "okay"; current-speed = <115200>; };
&nfct { status = "okay"; };                              // NFC tag on the two NFC pads (P0.09 / P0.10)
